{
  "name": "mutadiff",
  "version": "1.10.1",
  "private": true,
  "type": "module",
  "description": "Comparador de ejecuciones de mutation testing (PiTest / Stryker).",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "qs": "^6.16.0"
  },
  "scripts": {
    "build": "tsc -b",
    "pretest": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "tsc -b && npm run build -w web",
    "test:e2e": "playwright test --tsconfig=e2e/tsconfig.json",
    "coverage": "vitest run --coverage",
    "pretypecheck": "tsc -b",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "dev": "npm run dev -w web",
    "premutation": "tsc -b",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
